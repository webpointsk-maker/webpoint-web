# Odosielanie dopytov z formulára na e-mail cez https://resend.com
RESEND_API_KEY=
# Kam majú chodiť dopyty (voliteľné, predvolene kontaktný e-mail z webu)
LEAD_TO_EMAIL=
# Odosielateľ (voliteľné, predvolene "WebPoint <dopyt@webpointsk.com>" – doména je overená v Resend)
LEAD_FROM_EMAIL=
# Automatická odpoveď záujemcovi – zapnutá, vypnete hodnotou off
AUTO_REPLY=
